{
  "build": {
    "sourceDir": "templates",
    "outputDir": "dist",
    "cleanOutput": true,
    "minCliVersion": "1.0.3"
  },
  "targets": [
    {
      "id": "agents",
      "name": "Agents supporting .agents/skills/ and AGENTS.md",
      "bundleName": "agents.zip",
      "format": "markdown",
      "directories": {
        "skills": ".agents/skills",
        "guides": ".agents/apm-guides"
      },
      "replaces": [
        "codex",
        "cursor",
        "copilot",
        "antigravity",
        "opencode"
      ],
      "postInstallNote": null
    },
    {
      "id": "claude",
      "name": "Claude Code",
      "bundleName": "claude.zip",
      "format": "markdown",
      "directories": {
        "skills": ".claude/skills",
        "guides": ".agents/apm-guides"
      },
      "postInstallNote": null
    }
  ]
}
