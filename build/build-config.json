{
  "build": {
    "sourceDir": "templates",
    "outputDir": "dist",
    "cleanOutput": true,
    "postInstallNote": "If apm --version shows a version below 1.0.2, run npm install -g agentic-pm@latest to update it. Older versions can delete shared files when you remove an assistant."
  },
  "targets": [
    {
      "id": "claude",
      "name": "Claude Code",
      "bundleName": "claude.zip",
      "format": "markdown",
      "configDir": ".claude",
      "directories": {
        "commands": ".claude/skills",
        "skills": ".claude/skills",
        "guides": ".claude/apm-guides",
        "agents": ".claude/agents"
      },
      "postInstallNote": null
    },
    {
      "id": "codex",
      "name": "Codex CLI",
      "bundleName": "codex.zip",
      "format": "markdown",
      "configDir": ".codex",
      "directories": {
        "commands": ".agents/skills",
        "skills": ".agents/skills",
        "guides": ".agents/apm-guides",
        "agents": ".codex/agents"
      },
      "postInstallNote": "Codex CLI does not support custom slash commands. APM commands are installed as skills and invoked with the $ prefix (e.g., $apm-1-initiate-planner) instead of /slash-commands."
    },
    {
      "id": "cursor",
      "name": "Cursor",
      "bundleName": "cursor.zip",
      "format": "markdown",
      "configDir": ".cursor",
      "directories": {
        "commands": ".agents/skills",
        "skills": ".agents/skills",
        "guides": ".agents/apm-guides",
        "agents": ".cursor/agents"
      },
      "postInstallNote": null
    },
    {
      "id": "copilot",
      "name": "GitHub Copilot",
      "bundleName": "copilot.zip",
      "format": "markdown",
      "configDir": ".github",
      "directories": {
        "commands": ".agents/skills",
        "skills": ".agents/skills",
        "guides": ".agents/apm-guides",
        "agents": ".github/agents"
      },
      "agentFrontmatter": {
        "user-invocable": false
      },
      "postInstallNote": null
    },
    {
      "id": "antigravity",
      "name": "Antigravity",
      "bundleName": "antigravity.zip",
      "format": "markdown",
      "configDir": ".agents",
      "directories": {
        "commands": ".agents/skills",
        "skills": ".agents/skills",
        "guides": ".agents/apm-guides",
        "agents": ".agents/agents"
      },
      "agentFrontmatter": {
        "tools": [
          "view_file",
          "grep_search",
          "run_command"
        ],
        "subagent": true,
        "mainAgent": false
      },
      "postInstallNote": null
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "bundleName": "opencode.zip",
      "format": "markdown",
      "configDir": ".opencode",
      "directories": {
        "commands": ".agents/skills",
        "skills": ".agents/skills",
        "guides": ".agents/apm-guides",
        "agents": ".opencode/agents"
      },
      "agentFrontmatter": {
        "mode": "subagent"
      },
      "postInstallNote": "OpenCode runs APM commands as skills: type @ and the command name (e.g., @apm-1-initiate-planner)."
    }
  ]
}
